{
  "name": "subor-nes-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "复古小霸王风格的 Web 端 NES 模拟器（jsnes 内核 + Vue3 + Vite + TS）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "jsnes": "^2.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-win32-x64-msvc": "4.64.6"
  }
}
